{
  "name": "@ideabeam/web",
  "version": "0.1.0",
  "private": true,
  "description": "IdeaBeam: the web app. React, TypeScript, Vite, on the sebaro starter for a web app without a window.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/budget.ts",
    "preview": "vite preview --port 4173 --strictPort --host 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "release:check": "node scripts/release-check.ts",
    "checks": "pnpm lint && pnpm format:check && pnpm check && pnpm sebaro:verify && pnpm sebaro:product && pnpm test && pnpm build && pnpm sebaro:lint && pnpm test:e2e",
    "sebaro:verify": "node src/sebaro/checks/verify-export.mjs src/sebaro --strict",
    "sebaro:product": "python3 src/sebaro/product/product_kit.py check sebaro.product.json --copy src/sebaro --out sebaro-product",
    "sebaro:build": "python3 src/sebaro/product/product_kit.py build sebaro.product.json --copy src/sebaro --out sebaro-product --render",
    "sebaro:lint": "sh src/sebaro/checks/lint-web.sh src/app.css dist/client"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.13.0",
    "i18next": "27.2.6",
    "partysocket": "1.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3",
    "react-router": "8.5.2",
    "uqr": "0.1.3",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.70.1",
    "@eslint/js": "10.0.1",
    "@ideabeam/arrange": "workspace:*",
    "@ideabeam/shared": "workspace:*",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.167.0"
  },
  "prettier": {
    "printWidth": 120
  }
}
